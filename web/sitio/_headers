# Cloudflare Pages. El calendario escolar lo descarga la app al abrirse
# (src/lib/calendarioEscolar.ts): desde la app de escritorio y la de Android
# el origen no es aulapro.app, así que necesita CORS. Una hora de caché.
/calendario-escolar.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# La versión web de la app (aulapro.app/app/). La página, el service worker y
# la versión se piden siempre de nuevo: así una versión nueva llega en cuanto
# se publica. Lo de assets/ lleva la huella en el nombre y no cambia nunca.
/app/
  Cache-Control: no-cache
/app/index.html
  Cache-Control: no-cache
/app/sw.js
  Cache-Control: no-cache
/app/version.json
  Cache-Control: no-cache
/app/manifest.webmanifest
  Cache-Control: no-cache
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Content-Security-Policy de la app (29-10-2026): solo se carga código de la propia app y de Google
# (entrar con Google); se habla solo con la propia web, sus copias, Google Drive y Gemini. Los marcos
# admiten cualquier https porque la pizarra incrusta webs y vídeos que elige el docente. Si se añade
# un servicio nuevo que la app llama desde el navegador, hay que añadirlo aquí (connect-src). Los de Microsoft son
# OneDrive: la API (graph.microsoft.com) y los sitios a los que ésta redirige para bajar y subir archivos.
/app/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://aulapro.app https://www.aulapro.app https://aulapro-app.pages.dev https://prueba.aulapro-app.pages.dev https://aulapro-respaldo.netlify.app https://www.googleapis.com https://generativelanguage.googleapis.com https://accounts.google.com https://graph.microsoft.com https://*.sharepoint.com https://*.1drv.com https://*.microsoftpersonalcontent.com https://*.onedrive.com; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob: data: https:; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
