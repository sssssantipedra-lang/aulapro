# Cloudflare Pages. El calendario escolar lo descarga la app al abrirse
# (src/lib/calendarioEscolar.ts): desde la app de escritorio y la de Android
# el origen no es aulapro.app, así que necesita CORS. Una hora de caché.
/calendario-escolar.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# La versión web de la app (aulapro.app/app/). La página, el service worker y
# la versión se piden siempre de nuevo: así una versión nueva llega en cuanto
# se publica. Lo de assets/ lleva la huella en el nombre y no cambia nunca.
/app/
  Cache-Control: no-cache
/app/index.html
  Cache-Control: no-cache
/app/sw.js
  Cache-Control: no-cache
/app/version.json
  Cache-Control: no-cache
/app/manifest.webmanifest
  Cache-Control: no-cache
/app/assets/*
  Cache-Control: public, max-age=31536000, immutable
